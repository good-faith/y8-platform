# =============================================================================
# Y8 Platform Monorepo — Base .env Configuration (Local Development)
# Copy this file to `.env` at the monorepo root (or into each service folder)
# =============================================================================

# ─── 1. y8-app (Next.js Holographic Wallet UI — port 3000) ───────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_SECRET=replace-with-openssl-rand-hex-32

# Cross-service endpoints (inlined at Next.js build time)
NEXT_PUBLIC_Y8_SERVER_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_Y8_PREMIER_URL=http://localhost:3002
NEXT_PUBLIC_THE_BEACH_URL=http://localhost:3003

# Reown / WalletConnect Cloud Project ID (https://cloud.reown.com)
# Note: Coinbase Wallet works natively without this; used for WalletConnect QR
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=b56e18d47c72ab683b10814fe9495694

# ─── 2. y8-server (NestJS Agentic API — port 3001) ───────────────────────────
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# JWT signing secret (generate with: openssl rand -hex 64)
JWT_SECRET=replace-with-openssl-rand-hex-64
JWT_EXPIRES_IN=7d

# Base Chain RPC URLs
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Coinbase Developer Platform (CDP) AgentKit v2 — Headless Agent Wallets
# Obtain from: https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_NETWORK_ID=base-sepolia

# ─── 3. y8-premier (Vite + Express Financial Dashboard — port 3002) ──────────
# Cross-origin auth-sync host (y8-app)
VITE_Y8_APP_URL=http://localhost:3000
VITE_Y8_SERVER_URL=http://localhost:3001/api/v1
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Plaid Banking Integration (https://dashboard.plaid.com)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Google Gemini AI Financial Insights (https://aistudio.google.com)
GEMINI_API_KEY=

# ─── 4. the-beach (NestJS XR/VR Spatial Server — port 3003) ──────────────────
Y8_APP_URL=http://localhost:3000
Y8_SERVER_URL=http://localhost:3001/api/v1
REDIS_URL=redis://localhost:6379
KV_REST_API_URL=
KV_REST_API_TOKEN=
PKP_PUBLIC_KEY=

# Optional AI Agent Providers (used by y8-server / the-beach)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── 5. E2E Playwright Test Suite (optional overrides) ───────────────────────
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:3001/api/v1
E2E_PREMIER_URL=http://localhost:3002
E2E_BEACH_URL=http://localhost:3003
