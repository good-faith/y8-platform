{
  "name": "y8-platform",
  "version": "0.1.0-dev.1",
  "description": "Y8 Platform monorepo â€” wallet, XR, AI agents on Base",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "y8-app",
    "y8-server",
    "y8-premier",
    "the-beach",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "node dev.js",
    "stage": "powershell -ExecutionPolicy Bypass -File stage.ps1",
    "deploy": "powershell -ExecutionPolicy Bypass -File stage-fly.ps1",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "release:dev": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1 -Bump dev",
    "release:rc": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1 -Bump rc",
    "release:patch": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1 -Bump patch",
    "release:minor": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1 -Bump minor",
    "release:major": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1 -Bump major"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "mermaid": "^11.16.0"
  }
}
