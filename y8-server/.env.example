# y8-server Environment Variables
# Copy to .env.local and fill in values

# Server
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT (REQUIRED - generate with: openssl rand -hex 64)
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_64
JWT_EXPIRES_IN=7d

# Base Chain RPC (optional - defaults to public endpoints)
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ─── Coinbase AgentKit v2 (headless CDP wallet provisioning) ──────────────────
# Used by y8-server to create and manage Base wallets for AI agents.
# Get these at: https://portal.cdp.coinbase.com → API Keys
#
# Complement with the awal CLI for interactive ops:
#   npx awal auth login <email>  — authenticate interactively
#   npx awal balance             — check wallet balances
#   npx awal send 10 usdc 0x...  — fund an agent wallet
#   npx awal trade 10 eth usdc   — swap tokens
#   npx awal x402                — x402 payment commands
#
CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_KEY_SECRET=your-cdp-api-key-secret
CDP_WALLET_SECRET=your-cdp-wallet-secret
CDP_NETWORK_ID=base-sepolia

# Redis (optional - for persistent state + Bull queue)
REDIS_URL=redis://localhost:6379

# AI Services (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
