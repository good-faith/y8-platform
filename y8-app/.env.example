# ─── y8-server ────────────────────────────────────────────────────────────────
# URL of the running y8-server instance (no trailing slash)
NEXT_PUBLIC_Y8_SERVER_URL=http://localhost:3001/api/v1

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Public URL of this Next.js app
NEXTAUTH_URL=http://localhost:3000

# Random secret — generate with: openssl rand -hex 32
NEXTAUTH_SECRET=replace-me-with-openssl-rand-hex-32

# ─── WalletConnect ────────────────────────────────────────────────────────────
# Get a project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
